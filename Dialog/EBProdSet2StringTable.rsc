		{	String _name = "EBApothecaryLwr";		String _text = "薬剤師";	}
		{	String _name = "EBApothecaryTip";		String _text = "アポセカリーは、根、薬草、ワイン、種油、水、ガラス製品から健康アイテムを製造します。最大 2 人の薬剤師を雇って、3 ～ 4 つのヒーリング ブロス、ヒーリング オイル、または薬草 ティーを生産できます。建築サイクル: 60。";	}
		
		{	String _name = "EBHerbalist";		String _text = "薬草師";	}
		{	String _name = "EBHerbalistLwr";		String _text = "薬草医";	}
		{	String _name = "EBHerbalistTip";		String _text = "薬草医は薬草を集め、住民に簡単な健康と癒しを提供するために使用されます。最大 2 人の薬草医を雇用して、2 ～ 3 個の薬草を収集できます。建築サイクル: 42。";	}
		
		{	String _name = "EBGlassWorks";		String _text = "ガラス工房";	}
		{	String _name = "EBGlassWorksLwr";		String _text = "ガラス作品";	}
		{	String _name = "EBGlassWorksTip";		String _text = "Glass Works は、砂と石炭からガラスまたはガラス製品を製造します。最大 2 人のガラス職人を雇って、砂 23 + 石炭 3 または砂 23 + 工業用石炭 4 から 7 ～ 8 個のガラスまたは 7 ～ 8 個のガラス製品を生産できます。建築サイクル: 58。";	}
		
		{	String _name = "EBWinery";		String _text = "ワイン醸造所";	}
