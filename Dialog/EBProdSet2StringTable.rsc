		{	String _name = "EBWineryTip";		String _text = "ワイン醸造所では、ブドウ、プラム、チェリーからワインを生産しています。 1 人の醸造者を雇って、45 個のチェリー、グレープ、またはプラムから 7 ～ 10 個のワインを生産できます。建築サイクル: 72。";	}
		
		{	String _name = "EBOilPress";		String _text = "オイルプレス";	}
