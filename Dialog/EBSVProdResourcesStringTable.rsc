		{	String _name = "EBSVWoodCutterTip";		String _text = "Village Wood Cutter は、丸太を切って薪にするために使用され、その薪は冬の家の暖房に使用されます。木材カッターは最大 3 人まで使用できます。建築 サイクル: 36. 1 F キー テクスチャのバリエーション。";	}
		{	String _name = "EBSVTailor";		String _text = "村の仕立て屋";	}
