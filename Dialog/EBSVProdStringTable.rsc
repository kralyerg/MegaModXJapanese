		{	String _name = "EBSVApiaryTip";		String _text = "村の養蜂場はミツバチを飼育し、蜂蜜を生成するために使用されます。最大 2 人の養蜂職人を雇用して 16 ～ 22 個の蜂蜜を生産できます。建築サイクル: 46。2 F キーカラーバリエーション。";	}
		
		{	String _name = "EBSVPreservist";		String _text = "村の保護者";	}
