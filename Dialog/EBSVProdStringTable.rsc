		{	String _name = "EBSVTanneryLwr";		String _text = "村の皮なめし工場";	}
		{	String _name = "EBSVTanneryTip";		String _text = "村のなめし工場では硬化革を製造しています。 1 つのなめし職人を雇って、1 つの革、1 つの水、3 つの塩から 1 つの硬化革を生産できます。建築サイクル: 50。2 F キーカラーバリエーション。";	}
		
		{	String _name = "EBSVSaltMine";		String _text = "村の岩塩坑";	}
		{	String _name = "EBSVSaltMineLwr";		String _text = "村の塩坑";	}
		{	String _name = "EBSVSaltMineTip";		String _text = "村の塩鉱山は、塩鉱から塩を抽出します。塩の抽出と加工には最大 2 人の労働者を雇用できます。生産量：塩8～12個。建築 サイクル: 52。2 F キーのカラー バリエーション。";	}
		
		{	String _name = "EBSVWaterWell";		String _text = "村の水井戸";	}
		{	String _name = "EBSVWaterWellLwr";		String _text = "村の水井戸";	}
		{	String _name = "EBSVWaterWellTip";		String _text = "村の水井戸には水が溜まっています。 1 人の労働者を雇って、井戸から 12 ～ 16 個の水を集めることができます。建築サイクル: 42。2 F キーカラーバリエーション。";	}
		
		{	String _name = "EBSVShoemaker";		String _text = "村の靴屋";	}
		{	String _name = "EBSVShoemakerLwr";		String _text = "村の靴屋";	}
		{	String _name = "EBSVShoemakerTip";		String _text = "村の靴屋は靴を生産しています。 1 Cobbler を使用して、革、亜麻仁油、硬化革のいずれかから数種類の靴を製造できます。 建築サイクル: 50。2 F キーカラーバリエーション。";	}
		
		{	String _name = "EBSVOilPress";		String _text = "村のオイルプレス";	}
		{	String _name = "EBSVOilPressLwr";		String _text = "村の搾油機";	}
		{	String _name = "EBSVOilPressTip";		String _text = "村のオイルプレス では、25 穀粒と 1 アンフォラから 14 ～ 18 の植物油、25 ペカンから 14 ～ 18 の種油、または 25 クルミと 1 アンフォラから 14 ～ 18 の亜麻仁油、または 25 の亜麻と 1 アンフォラから 14 ～ 18 の亜麻仁油が生産されます。最大 2 台のプレッサーを使用して、ピーカンまたはクルミから 18 ～ 24 個の種油を生産し、50 粒の穀粒から 18 ～ 24 個の植物油を生産し、50 個の亜麻から 18 ～ 24 個の亜麻仁油を生産できます。建築サイクル: 48。2 F キーカラーバリエーション。";	}
		
		{	String _name = "EBSVSandPit";		String _text = "村の砂場";	}
		{	String _name = "EBSVSandPitLwr";		String _text = "村の砂場";	}
		{	String _name = "EBSVSandPitTip";		String _text = "村の砂場では砂が生産されます。最大 3 人の労働者を雇用して 5 ～ 7 個の砂を生産できます。建築 サイクル: 36。2 F キーのカラー バリエーション。";	}
		
		{	String _name = "EBSVPottery";		String _text = "村の陶器";	}
		{	String _name = "EBSVPotteryLwr";		String _text = "村の陶器";	}
		{	String _name = "EBSVPotteryTip";		String _text = "村の陶器はアンフォラを生産しています。 1 つの陶芸家を使用して、4 つの粘土と 1 つの石炭または 1 つの木炭から 3 ～ 4 つのアンフォラを生産できます。建築サイクル: 50。2 F キーカラーバリエーション。";	}
		
