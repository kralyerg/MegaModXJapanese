		{	String _name = "EBSVClayPitTip";		String _text = "村の粘土ピットでは粘土が生産されます。最大 3 人の労働者を雇用して 5 ～ 7 個の粘土を生産できます。建築 サイクル: 36。2 F キーのカラー バリエーション。";	}
		
		{	String _name = "EBSVApiary";		String _text = "村の養蜂場";	}
