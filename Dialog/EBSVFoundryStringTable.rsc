		{	String _name = "EBSVSmelter";		String _text = "鉄精錬所";	}
		{	String _name = "EBSVSmelterLwr";		String _text = "鉄精錬所";	}
		{	String _name = "EBSVSmelterTip";		String _text = "鉄精錬所は、鉄鉱石と選択したいくつかの燃料から鉄を作成するために使用されます。最大 2 つの製錬所を使用して 1 ～ 2 個の鉄を作成できます。建築 サイクル: 62。1 F キー テクスチャのバリエーション。";	}
		{	String _name = "SVOreToIronCoalRequire";		String _text = "鉄 [鉄鉱石 2 個 + 石炭 1 個]";	}
