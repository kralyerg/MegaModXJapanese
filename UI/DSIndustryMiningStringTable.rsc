		{	String _name = "DSWaterPowerFurnace";		String _text = "水力溶鉱炉";	}
		{	String _name = "DSWaterPowerFurnaceLwr";		String _text = "溶鉱炉";	}
		{	String _name = "DSWaterPowerFurnaceTip";		String _text = "小川や川のそばに建設する必要があるこの溶鉱炉は、高温と大量の送風により、産業都市に最適な施設です。水力で大型のふいごを動かし、炉内に空気を送り込みます。冶金用燃料(コークスまたは炭)を使い、大量の鉄鉱石を鉄に、銅鉱石を銅に、錫鉱石を錫に、または銅と錫の鉱石を青銅に加工できます。鍛冶師1~8人を雇用。建設労働力233。";	}
		{	String _name = "DSBlastFurnace";		String _text = "高炉";	}
		{	String _name = "DSBlastFurnaceLwr";		String _text = "高炉";	}
		{	String _name = "DSBlastFurnaceTip";		String _text = "高温と大気流を利用する高炉は、工業地帯への完璧な追加です。精製燃料（コークス、木炭、炉燃料）を使用して、大量の鉄鉱石を鉄に加工できます。炉の建設には 144 の作業が必要です。";	}
