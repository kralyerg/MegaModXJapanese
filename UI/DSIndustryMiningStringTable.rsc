StringTable startConditions
{
	Entry _strings
	[
		{	String _name = "Easy0Name";		String _text = "産業：道具";	}
		{	String _name = "Easy0Desc";		String _text = "初心者向けのゲームで、5家族と住居から始まります。衣服、食料、薪、木炭、道具、丸太、鉄、石材が豊富に用意されています。サッド・スレルの貯蔵倉庫に加え、サッド・スレルの鍛冶屋、鍛冶炉と砥石もすでに建設済みです。畑や果樹園用の種もいくつか用意されており、家畜の群れもあります。";	}
		{	String _name = "Easy2Name";		String _text = "産業：亜麻・麻布・ランプ油";	}
		{	String _name = "Easy2Desc";		String _text = "初心者向けのゲームで、5家族と住居から始まります。衣服、食料、薪、木炭、道具、丸太、鉄、石材が豊富に用意されています。サッド・スレルの貯蔵倉庫に加え、サッド・スレルの亜麻織り場、オイル窯、搾油小屋もすでに建設済みです。畑用の亜麻の種と果樹園用の種が用意されており、家畜の群れもあります。";	}
		{	String _name = "Medium0Name";		String _text = "産業：サッド・スレル貯蔵倉庫";	}
		{	String _name = "Medium0Desc";		String _text = "中級者向けのゲームで、5家族から始まります。衣服、食料、薪、道具に加え、丸太、鉄、石材も多少用意されています。サッド・スレルの貯蔵倉庫はすでに建設済みです。畑や果樹園用の種もいくつか用意されています。";	}
		{	String _name = "Hard0Name";		String _text = "産業：炭焼き職人";	}
		{	String _name = "Hard0Desc";		String _text = "上級者向けのゲームで、4家族から始まります。衣服、食料、道具、石材が多少と、丸太が大量に用意されています。物資を収めた貯蔵用の樽や箱がいくつかあり、炭焼き窯も2基すでに建設済みです。";	}
		{	String _name = "Hard1Name";		String _text = "産業：鉱石精錬職人";	}
		{	String _name = "Hard1Desc";		String _text = "上級者向けのゲームで、4家族から始まります。衣服、食料、道具、石材、木炭、丸太が多少用意されています。物資を収めた貯蔵用の樽や箱がいくつかあり、製錬炉（銅用・鉄用）2基と小さな炭焼き窯もすでに建設済みです。";	}
	]

}
