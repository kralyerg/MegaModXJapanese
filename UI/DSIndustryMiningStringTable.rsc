		{	String _name = "DSCoalBellPit1Lwr";		String _text = "コールベルピット";	}
		{	String _name = "DSCoalBellPit1Tip";		String _text = "平らな地面に建設された原始的な石炭鉱山には、地面にある「鐘」型の穴からのみ石炭を抽出する 3 ～ 8 人の鉱山労働者が必要です。限定生産（600個）のため、その後廃番となります。鉱山の建設には 34 の作業が必要です。";	}
		{	String _name = "DSCoalBellPit1Upgrade";		String _text = "コールベルピット鉱山";	}
		{	String _name = "DSCoalBellPit1UpgradeLwr";		String _text = "コールベルピット鉱山";	}
		{	String _name = "DSCoalBellPit1UpgradeTip";		String _text = "アップグレードすると、寿命が長くなり (5,400)、採掘者を支援する滑車システムの追加により石炭の抽出がわずかに速くなります (最大 13 名の採掘者)。鉱山をアップグレードするには 89 の作業が必要です。";	}
		{	String _name = "DSSmallIronOreMine";		String _text = "小さな鉄鉱石鉱山";	}
		{	String _name = "DSSmallIronOreMineLwr";		String _text = "小さな鉄鉱石鉱山";	}
		{	String _name = "DSSmallIronOreMineTip";		String _text = "1 ～ 13 人の鉱山労働者が雇用され、鉄鉱石のみを採掘する小さな山岳鉱山です。生産数は限られています (1200 台) が、アップグレードして動作を継続できます。鉱山の建設には 34 の作業が必要です。";	}
		{	String _name = "DSSmallIronOreMineUpgradeOilLamps";		String _text = "鉄鉱石の鉱山";	}
		{	String _name = "DSSmallIronOreMineUpgradeOilLampsLwr";		String _text = "鉄鉱石の鉱山";	}
		{	String _name = "DSSmallIronOreMineUpgradeOilLampsTip";		String _text = "アップグレードにより寿命が24,800まで延び、最大21人の採掘者を雇用して鉄鉱石の採掘がやや速くなります。アップグレードには労働力89が必要です。";	}
		{	String _name = "ImprovedMine";		String _text = "改良型鉱山";	}
		{	String _name = "ImprovedMineLwr";		String _text = "改良型鉱山";	}
		{	String _name = "ImprovedMineTip";		String _text = "Yandersenとの共同制作による改良型鉱山モデル。山岳鉱山で、採掘者1~30人を雇用し、鉄鉱石・銅鉱石・石炭のいずれかを採掘します。生産量は21,000に限定されています。建設労働力144。";	}
		{	String _name = "DSThaddSurrelMineOilLamps";		String _text = "サッド・サレル一家:産業鉱山";	}
		{	String _name = "DSThaddSurrelMineOilLampsLwr";		String _text = "産業鉱山";	}
		{	String _name = "DSThaddSurrelMineOilLampsTip";		String _text = "サッド・サレル一家の産業鉱山。鉄鉱石・銅鉱石・錫鉱石・石炭のいずれかを採掘可能。稼働には木材とランプ油またはろうそくが必要です。採掘者1~55人を雇用。生産量は寿命を通じて250,000に達します。建設労働力233。";	}
		{	String _name = "DSIndustryMineSecond";		String _text = "サッド・サレル一家:第2産業鉱山";	}
		{	String _name = "DSIndustryMineSecondLwr";		String _text = "第2産業鉱山";	}
		{	String _name = "DSIndustryMineSecondTip";		String _text = "サッド・サレル一家の大規模な第2産業鉱山。鉄鉱石・銅鉱石・錫鉱石・石炭のいずれかを採掘可能。稼働には木材とランプ油またはろうそくが必要です。採掘者1~72人を雇用。生産量は寿命を通じてほぼ無尽蔵の5,000,000に達します。建設労働力512。";	}
		{	String _name = "DSClarenceSilverMine01";		String _text = "クラレンス銀山(★1)";	}
		{	String _name = "DSClarenceSilverMine01Lwr";		String _text = "クラレンス銀山";	}
		{	String _name = "DSClarenceSilverMine01Tip";		String _text = "クラレンス銀山は大規模な銀鉱石の鉱山で、最初は★1レベルで建設されます。採掘者1~8人を雇用し、稼働には木材とランプ油2が必要です。銀鉱石の採掘を続けるには、一定量を採掘した後にアップグレードが必要です。建設労働力89。";	}
		{	String _name = "DSClarenceSilverMine02";		String _text = "クラレンス銀山(★2)";	}
		{	String _name = "DSClarenceSilverMine02Lwr";		String _text = "クラレンス銀山";	}
		{	String _name = "DSClarenceSilverMine02Tip";		String _text = "鉱山をアップグレードし、後方の選別室を拡張してより大きな坑口を作ります。既存の坑道は強化され、やや多い13人の採掘者に対応します。アップグレード後の総生産量は610で、それ以降は再度アップグレードが必要です。建設労働力144。";	}
		{	String _name = "DSClarenceSilverMine03";		String _text = "クラレンス銀山(★3)";	}
		{	String _name = "DSClarenceSilverMine03Lwr";		String _text = "クラレンス銀山";	}
		{	String _name = "DSClarenceSilverMine03Tip";		String _text = "鉱山をアップグレードすると、大型の滑車システムが追加され、より深い採掘が可能になり、重い鉱石を地上へ運ぶ作業も楽になるため採掘速度が上がります。最大21人の採掘者を雇用可能。アップグレード後の総生産量は1,597で、それ以降は再度アップグレードが必要です。建設労働力233。";	}
		{	String _name = "DSClarenceSilverMine04";		String _text = "クラレンス銀山(★4)";	}
		{	String _name = "DSClarenceSilverMine04Lwr";		String _text = "クラレンス銀山";	}
		{	String _name = "DSClarenceSilverMine04Tip";		String _text = "滑車をさらに追加してシステムを強化!採掘速度がさらに向上し、最大34人の採掘者を雇用できるようになります。それだけでなく、鉱山の照明もアップグレードされ、採掘者が必要とするランプ油が1個のみとなり生産効率が向上します。アップグレード後の総生産量は4,181で、それ以降は再度アップグレードが必要です。建設労働力377。";	}
		{	String _name = "DSClarenceSilverMine05";		String _text = "クラレンス銀山(★5)";	}
		{	String _name = "DSClarenceSilverMine05Lwr";		String _text = "クラレンス銀山";	}
		{	String _name = "DSClarenceSilverMine05Tip";		String _text = "鉱山をアップグレードすると、鉄道の線路が設置され、より速いトロッコが使えるようになり生産速度が上がります。これが鉱山の最終的な深さであり、この先は銀鉱石が枯渇します。総生産量は10,946。建設労働力610。";	}
		{	String _name = "UpgradeClarenceSilverMine01Txt";		String _text = "枯渇したら鉱山をアップグレード:";	}
