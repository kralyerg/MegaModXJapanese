		{	String _name = "RKCemeteryLwr";		String _text = "不気味な墓地のツールバー";	}
		{	String _name = "RKCemeteryTip";		String _text = "不気味な墓地のセレクションを開きます。 不気味な墓地 は私がリリースした MOD で、石と鍛造金属を使用しており、ちょっと不気味な特別な外観を持っています。";	}

		{	String _name = "RKFencelessCemetery";		String _text = "柵のない墓地";	}
		{	String _name = "RKFencelessCemeteryLwr";		String _text = "柵のない墓地";	}
		{	String _name = "RKFencelessCemeteryTip";		String _text = "柵のない墓地を設置します。サイズ: 5x5 のタイルをクリックして最大 40x40 のタイルまでドラッグします。コスト: タイルあたり 1 石 (人が死ぬときに使用) ヒント: 柵レス。つまり、周囲に柵が見えないことを意味します。";	}

		{	String _name = "RKMetalCemetery";		String _text = "金属柵墓地";	}
		{	String _name = "RKMetalCemeteryLwr";		String _text = "金属柵の墓地";	}
		{	String _name = "RKMetalCemeteryTip";		String _text = "金属柵の墓地を設置します。サイズ: 5x5 のタイルをクリックして最大 40x40 のタイルまでドラッグします。コスト: タイルごとに石 1 個、鉄 1 個。ヒント: 柵は半分が石で、半分が鍛造金属になります。";	}

		{	String _name = "RKCrypt1";		String _text = "地下室";	}
