		{	String _name = "DSChapelofErnest";		String _text = "聖アーネスト礼拝堂";	}
		{	String _name = "DSChapelofErnestLwr";		String _text = "アーネストの礼拝堂";	}
		{	String _name = "DSChapelofErnestTip";		String _text = "聖アーネスト礼拝堂を建設します。この礼拝を行うには聖職者が必要です。礼拝堂は市民に集会と礼拝の場を提供し、最大 201 人の会員に精神的な幸福を提供します。これには聖職者も含まれます。 7×10のタイル。建設には 155 の建築作業が必要です。聖アーネスト礼拝堂はマップ上に 1 つだけ建設できます。";	}
		
		{	String _name = "DSChapelofErnestUITxt01";		String _text = "聖アーネスト礼拝堂";	}
		{	String _name = "DSChapelofErnestUITxt02";		String _text = "最大 201 人の国民が集い、礼拝できる場所です。";	}
		
	]
