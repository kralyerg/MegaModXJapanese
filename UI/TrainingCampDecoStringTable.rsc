		{	String _name = "CitationRKTrainingCamp1Tip";		String _text = "あなたは、あなたの子供たちを生きた矢として送り出す弓です。 - ハリル・ジブラン。";	}
		{	String _name = "CitationRKTrainingCamp2Tip";		String _text = "どの国にも国旗があります。 - アイマン・オデ。";	}
		{	String _name = "CitationRKTrainingCamp3Tip";		String _text = "攻撃は防御の秘密です。防御とは攻撃を計画することです。 - 孫子。";	}
		{	String _name = "CitationRKTrainingCamp4Tip";		String _text = "私は建築がシェルターだけを指すのではなく、非常に単純な囲いを指すだけだと思います。それはあなたを興奮させ、落ち着かせ、考えさせることができるはずです。 - ザハ・ハディド。";	}
		{	String _name = "CitationRKTrainingCamp5Tip";		String _text = "人類には本当に効果的な武器が 1 つあります。それは笑いです。 - マーク・トウェイン。";	}
