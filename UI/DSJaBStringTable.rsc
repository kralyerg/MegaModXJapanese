		{	String _name = "DSJaBJettyHome3x2Lwr";		String _text = "労働者の家";	}
		{	String _name = "DSJaBJettyHome3x2Tip";		String _text = "4 人の市民のための小さな桟橋の家、頭上の居住スペースを備えたより大きな居住区。この従業員の家では、暖房する面積が広いため、暖房が不十分です。 900キャップ。 3×2。構築するには 34 の作業が必要です。水上または地上に建設可能 - 正面玄関に住民がアクセスできることを確認してください。加熱: 燃料の温度 50 度、燃料からの熱 65 度。";	}
		
		
		{	String _name = "DSJaBJettyHome3x3";		String _text = "桟橋の小さな家";	}
