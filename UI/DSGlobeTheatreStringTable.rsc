		{	String _name = "DSGlobeTheatreLwr";		String _text = "グローブシアター";	}
		{	String _name = "DSGlobeTheatreTip";		String _text = "シェイクスピアのグローブ座のスタイル。パフォーマーを劇場で雇用すると、市民に幸福をもたらし、少額のシルバーを獲得できます。建設には610の作業が必要です。グローブ座は1つの町に1つだけ建てることができます。";	}
		
		
		{	String _name = "EnableWorkDSGlobeTheatre";		String _text = "劇場が上演中です";	}
		{	String _name = "EnableWorkDSGlobeTheatreTip";		String _text = "このシアターの使用を有効または無効にします。";	}
		{	String _name = "DisableWorkDSGlobeTheatre";		String _text = "劇場は閉まっています";	}
		{	String _name = "workPlaceDSGlobeTheatreTxt";		String _text = "グローブ座では、出演者が市民を楽しませ、幸せをもたらし、少額のシルバーを獲得します。";	}
		
