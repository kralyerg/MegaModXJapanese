		{	String _name = "CCMediumPlus";		String _text = "[CC]中+";	}
		{	String _name = "CCMediumPlusDesc";		String _text = "家畜を追加します。中規模以上のゲームは 5 つの家族から始まります。衣類、食料、薪、工具、建設資材が提供されます。すでに倉庫が建てられています。畑や果樹園用の種や家畜の群れも入手できます。";	}
		
		{	String _name = "CCMissionary";		String _text = "[CC] 宣教師";	}
		{	String _name = "CCMissionaryDesc";		String _text = "宣教師のゲームは教区の家と 3 つの家族から始まりますが、そのうち 2 人は教育を受けていません。すでに2軒の家が建てられており、いくつかの基本的な物資が提供されています。収納台車をご利用いただけます。畑や果樹園用の種や家畜の群れも入手できます。";	}

