		{	String _name = "CCAdamEve";		String _text = "[CC] アダムとイブ";	}
		{	String _name = "CCAdamEveDesc";		String _text = "たった2人からスタート。少量の食料、薪、衣類は小さな収納台車に入れて提供されます。建物はまだ建設されておらず、種や家畜も最初は利用できません。生き残ってすべてを手に入れる必要があります。";	}

		{	String _name = "CCSilkRoad";		String _text = "[CC] シルク道 - 簡単";	}
		{	String _name = "CCSilkRoadDesc";		String _text = "まずは、貴重なシルクを得るために蚕に餌を与えて収穫することから始めましょう。 6家族から始まります。大量の衣類、食料、薪、建築資材、道具が提供されます。家や倉庫はすでに建てられています。";	}
		
		{	String _name = "CCSilkRoadMed";		String _text = "[CC] シルク道 - 中";	}
		{	String _name = "CCSilkRoadMedDesc";		String _text = "まずは、貴重なシルクを得るために蚕に餌を与えて収穫することから始めましょう。 5家族から始まります。衣類、食料、薪、工具、建設資材が提供されます。すでに倉庫が建てられています。";	}
		
		{	String _name = "CCMine";		String _text = "[CC] 私のもの";	}
