		{	String _name = "UpStoneHouse";		String _text = "★祝福された石造りの家";	}
		{	String _name = "UpStoneHouseLwr";		String _text = "★祝福された石造りの家";	}
		{	String _name = "UpStoneHouseTip";		String _text = "聖ベルの祝福を得る。祝福された石造りの家は火災や竜巻の影響を受けなくなる。この建物を再建するには聖ベルの涙が必要。聖ベルの涙は聖ベルニワトリを繁殖させることで入手できる。";	}
		{	String _name = "UpChapel";		String _text = "★祝福された礼拝堂";	}
		{	String _name = "UpChapelLwr";		String _text = "★祝福された礼拝堂";	}
		{	String _name = "UpChapelTip";		String _text = "聖ベルの祝福と悲しみの雨の魂を得る。祝福された礼拝堂は火災や竜巻の影響を受けなくなり、さらに収容人数が2倍になる。この建物を再建するには聖ベルの涙が必要。悲しみの雨の魂は建物の機能を強化できる。聖ベルの涙は聖ベルニワトリを繁殖させることで入手でき、悲しみの雨の魂は墓を掘ることで入手できるが、その前に墓石を解体する必要がある。";	}
		{	String _name = "UpCropField";		String _text = "★祝福された畑";	}
