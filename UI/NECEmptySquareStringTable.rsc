		{	String _name = "NECEmptySquareLwr";		String _text = "空の広場";	}
		{	String _name = "NECEmptySquareTip";		String _text = "何もない広場。これは、目に見えない正方形を持つ 1x1 タイルです。ゴースト装飾レーション使用時にバニーの通過や木等の成長を防ぐ設計となっております。";	}

		{	String _name = "NECEmptySquarePassable";		String _text = "通行可能な広場";	}
		{	String _name = "NECEmptySquarePassableLwr";		String _text = "通行可能な広場";	}
		{	String _name = "NECEmptySquarePassableTip";		String _text = "無難な空き広場。これは、目に見えない正方形を持つ 1x1 タイルです。道路上に設置し、バニーの通行は可能ですが、ゴースト装飾レーションを使用するときに木などの成長を止めるように設計されています。";	}

		{	String _name = "NECEmptyField";		String _text = "空のフィールド";	}
		{	String _name = "NECEmptyFieldLwr";		String _text = "空のフィールド";	}
		{	String _name = "NECEmptyFieldTip";		String _text = "空のフィールド。これはドラッグ可能な目に見えないフィールドで、野生の木や資源の成長を妨げます。湖や池などの大きな装飾エリアの下に置くのに最適です。バニーは必要に応じてこのフィールドを通過します。";	}

