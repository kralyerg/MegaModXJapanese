		{	String _name = "JungleMediumName";		String _text = "[CC] マタカパン ジャングル - 中";	}
		{	String _name = "JungleMediumDesc";		String _text = "MOD とゲームに含まれるすべてのツリーを含む標準的なミディ​​アム ゲーム。中試合は 5 つの家族で始まります。衣類、食料、薪、工具、建設資材が提供されます。すでに倉庫が建てられています。畑や果樹園用の種もいくつかあります。";	}

		{	String _name = "JungleHardName";		String _text = "[CC] マタカパン ジャングル - ハード";	}
		{	String _name = "JungleHardDesc";		String _text = "MOD とゲームに含まれるすべてのツリーを備えた標準的なハード ゲーム。家族4人による過酷なゲームが始まる。少量の衣類、食料、薪、道具が提供されます。農業用の種は入手できません。";	}

