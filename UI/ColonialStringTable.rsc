		{	String _name = "CCcustom1Name";		String _text = "植民地憲章";	}
		{	String _name = "CCcustom1Desc";		String _text = "植民地憲章の説明はここにあります";	}

		{	String _name = "CCAdamEve";		String _text = "[CC] アダムとイブ";	}
		{	String _name = "CCAdamEveDesc";		String _text = "たった2人からスタート。少量の食料、薪、衣類は小さな収納台車に入れて提供されます。建物はまだ建設されておらず、種や家畜も最初は利用できません。生き残ってすべてを手に入れる必要があります。";	}

		{	String _name = "CCSilkRoad";		String _text = "[CC] シルク道 - 簡単";	}
		{	String _name = "CCSilkRoadDesc";		String _text = "まずは、貴重なシルクを得るために蚕に餌を与えて収穫することから始めましょう。 6家族から始まります。大量の衣類、食料、薪、建築資材、道具が提供されます。家や倉庫はすでに建てられています。";	}
		
		{	String _name = "CCSilkRoadMed";		String _text = "[CC] シルク道 - 中";	}
		{	String _name = "CCSilkRoadMedDesc";		String _text = "まずは、貴重なシルクを得るために蚕に餌を与えて収穫することから始めましょう。 5家族から始まります。衣類、食料、薪、工具、建設資材が提供されます。すでに倉庫が建てられています。";	}

		{	String _name = "CCSilkRoadHard";		String _text = "[CC] シルク道 - ハード";	}
		{	String _name = "CCSilkRoadHardDesc";		String _text = "まずは、貴重なシルクを得るために蚕に餌を与えて収穫することから始めましょう。 家族4人による過酷なゲームが始まる。少量の衣類、食料、薪、道具が提供されます。入手可能な種はホワイトマルベリーの種のみです。";	}
		
		{	String _name = "CCMine";		String _text = "[CC] 私のもの";	}

		{	String _name = "CCMineDesc";		String _text = "貴重なアイテムのためのユニークな採掘。";	}

		{	String _name = "CCMediumPlus";		String _text = "[CC]中+";	}
		{	String _name = "CCMediumPlusDesc";		String _text = "家畜を追加します。中規模以上のゲームは 5 つの家族から始まります。衣類、食料、薪、工具、建設資材が提供されます。すでに倉庫が建てられています。畑や果樹園用の種や家畜の群れも入手できます。";	}
		
		{	String _name = "CCMissionary";		String _text = "[CC] 宣教師";	}
		{	String _name = "CCMissionaryDesc";		String _text = "宣教師のゲームは教区の家と 3 つの家族から始まりますが、そのうち 2 人は教育を受けていません。すでに2軒の家が建てられており、いくつかの基本的な物資が提供されています。収納台車をご利用いただけます。畑や果樹園用の種や家畜の群れも入手できます。";	}
		
		{	String _name = "CCFort";		String _text = "[CC] ニューフロンティア";	}
		{	String _name = "CCFortDesc";		String _text = "ニュー フロンティアは、フレンドリーなネイティブ アメリカンの村に隣接する辺境の前哨基地から始まります。国民を守り育てれば、あなたの伝説は西側に永遠に語り継がれるでしょう。このゲームは 3 つの家族から始まり、いくつかの物資を備えた小さな砦がすでに建設されています。儀式場で宝物を発見するオプションが含まれます。";	}

		{	String _name = "CCFortHard";		String _text = "[CC] ネイティブ ヴィレッジ - ハード";	}
		{	String _name = "CCFortHardDesc";		String _text = "ネイティブ ビレッジのスタートでは、その地域の先住民部族と良好な関係を築く必要があり、かなり難しいスタートです。村では友情を示すための資源 (アップグレード) が必要になります。その後、建物とどのように対話するかを選択できます。この土地の外国人として、敵ではなく同盟を求めることから学び、得るものはたくさんあります。";	}

		{	String _name = "CCFortAE";		String _text = "[CC] ネイティブ ビレッジ - アダムとイブ";	}
		{	String _name = "CCFortAEDesc";		String _text = "たった2人からスタート。少量の食料、薪、衣類は小さな収納台車に入れて提供されます。ネイティブ ビレッジのスタートでは、その地域の先住民部族と良好な関係を築く必要があり、かなり難しいスタートです。村では友情を示すための資源 (アップグレード) が必要になります。その後、建物とどのように対話するかを選択できます。この土地の外国人として、敵ではなく同盟を求めることから学び、得るものはたくさんあります。";	}

		{	String _name = "PalmsOnlyEasyName";		String _text = "[CC] アンティル諸島 - 簡単";	}
		{	String _name = "PalmsOnlyEasyDesc";		String _text = "ヤシの木と熱帯の木だけを使った標準的な簡単なゲーム。 6人の家族で簡単なゲームが始まります。大量の衣類、食料、薪、建築資材、道具が提供されます。家や倉庫はすでに建てられています。畑や果樹園用の種のほか、家畜の群れも入手できます。";	}

		{	String _name = "PalmsOnlyMediumName";		String _text = "[CC] アンティル諸島 - 中";	}
		{	String _name = "PalmsOnlyMediumDesc";		String _text = "ヤシの木と熱帯の木のみを使用した標準の中規模ゲーム。中試合は 5 つの家族で始まります。衣類、食料、薪、工具、建設資材が提供されます。すでに倉庫が建てられています。畑や果樹園用の種もいくつかあります。";	}

