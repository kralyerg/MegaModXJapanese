StringTable resource
{
	Entry _strings
	[ 
		{	String _name = "DSStythTowerMenuTip";		String _text = "Styth Towers - あなたの街の監視塔。スタッフが配置されている場合、彼らは盗賊としか思えない人々から盗まれたアイテムを押収して、ランダムに選択した商品を生成します。それとも宇宙人か……";	}
	
		{	String _name = "DSStythTower";		String _text = "スティス・タワー";	}
		{	String _name = "DSStythTowerLwr";		String _text = "スティスタワー";	}
		{	String _name = "DSStythTowerTip";		String _text = "Styth Tower は、エリアから山賊を排除することで町に少量のランダムなアイテム (アルコール、道具、衣類、食品など) を生成するオリジナルの Styth 監視塔で、町は戦利品を受け取ります。村の衛兵を1～2名雇用している。マップ上に建てられる Styth Tower は 1 つだけです。";	}
		
		{	String _name = "DSNewStythTower";		String _text = "ニュー・スティス・タワー";	}
		{	String _name = "DSNewStythTowerLwr";		String _text = "新しいスティスタワー";	}
		{	String _name = "DSNewStythTowerTip";		String _text = "新しいスタイス タワー、新しいアップデート スタイス タワー、サイズがわずかに大きく、この監視塔は山賊のエリアを排除することにより、町のためにより多くのランダム アイテム (アルコール、道具、衣類、食料、貴重品など) を生成します。町は受け取ります。戦利品。 2～3人の村衛兵を雇っている。マップ上に建設できる New Styth Tower は 1 つだけです。";	}
		
		{	String _name = "ProfessionVillageGuard";		String _text = "村の衛兵";	}
		{	String _name = "ProfessionVillageGuardTip";		String _text = "村の警備員は町に奉仕し、町を守るために雇用されています。彼らはものみの塔で雇用されています。他の職業に比べて死亡率が高いことは認められています。";	}
		{	String _name = "ProfessionVillageGuardDeath";		String _text = "山賊から町を守った後、重傷を負って死亡した。";	}
		
		
		{	String _name = "Gold";		String _text = "金鉱石";	}
		{	String _name = "Silver";		String _text = "銀の鉱石";	}
		{	String _name = "Gems";		String _text = "宝石";	}
		
		{	String _name = "Lumber";		String _text = "木材";	}
	]
}
