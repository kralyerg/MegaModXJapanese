		{	String _name = "DSSVWell2x2Tip";		String _text = "F キーのバリエーション、消火用の大きな村の井戸 (2000 ユニット)。構築するには 144 の作業が必要です。";	}
		
		
		{	String _name = "DSSVHerbalist";		String _text = "村の薬草医";	}
		{	String _name = "DSSVHerbalistLwr";		String _text = "村の薬草医";	}
		{	String _name = "DSSVHerbalistTip";		String _text = "村の薬草医は、住民の健康を保つ上で重要な役割を果たしています。彼らは薬草を集め、住民に簡単な健康と癒しを提供します。 1～2名の薬草医を雇用。構築するには 34 の作業が必要です。";	}	
		
		{	String _name = "DSSVHospital";		String _text = "村の病院";	}
		{	String _name = "DSSVHospitalLwr";		String _text = "村の病院";	}
		{	String _name = "DSSVHospitalTip";		String _text = "村の病院は、病気の住民が訪問し、医師の治療を受ける場所を提供します。これを建設して基本的な病院を入手します。建設時に、建物情報パネルのボタンを使用して病院をアップグレードできます。 144の作業が必要です。";	}
		{	String _name = "HospitalUpgrade1Tip";		String _text = "村の病院をアップグレードします。患者収容能力は 45 人大きくなり、医師 1 ～ 2 人が雇用され、石壁と小さな庭の改善の外側に新しい棟が追加されます。 55の作業が必要です。";	}
				
		
		{	String _name = "DSSVVillageHall";		String _text = "村役場";	}
		{	String _name = "DSSVVillageHallLwr";		String _text = "村役場";	}
		{	String _name = "DSSVVillageHallTip";		String _text = "村役場は住民に幸福を与えるだけでなく、プレイヤーに村のデータを記録して表示します。マップ上には最大 3 つの村役場を配置できます。";	}
		
		{	String _name = "DSSVSchool";		String _text = "小さな村の学校";	}
		{	String _name = "DSSVSchoolLwr";		String _text = "小さな村の学校";	}
		{	String _name = "DSSVSchoolTip";		String _text = "小さな村の学校。 20 人の生徒に教育を提供し、1 人の教師を雇用します。構築するには55の作業が必要です。";	}
		
		{	String _name = "DSSVChapel";		String _text = "村の礼拝堂";	}
		{	String _name = "DSSVChapelLwr";		String _text = "村の礼拝堂";	}
		{	String _name = "DSSVChapelTip";		String _text = "村の礼拝堂。定員50名。構築するには89の作業が必要です。";	}
		
		{	String _name = "DSSVChurch";		String _text = "村の教会";	}
		{	String _name = "DSSVChurchLwr";		String _text = "村の教会";	}
		{	String _name = "DSSVChurchTip";		String _text = "村の教会。定員120名。構築するには 144 の作業が必要です。";	}
		
		{	String _name = "DSSVCemeteryMenuTip";		String _text = "小さな村の墓地";	}
		
			{	String _name = "DSSVCemetery";		String _text = "村の墓地";	}
			{	String _name = "DSSVCemeteryLwr";		String _text = "村の墓地";	}
			{	String _name = "DSSVCemeteryTip";		String _text = "村の墓地。最小 7x7、最大 30x30。各タイルを構築するには、1 つの石 + 1 つの作業が必要です。墓石は4〜6年間墓地に残ります。";	}
		
			{	String _name = "DSSVCemeterySmall";		String _text = "小さな村の墓地";	}
			{	String _name = "DSSVCemeterySmallLwr";		String _text = "小さな村の墓地";	}
			{	String _name = "DSSVCemeterySmallTip";		String _text = "小さな村の墓地。最小 5x5、最大 15x15。各タイルを構築するには、1 つの木材 + 1 つの作業が必要です。墓石は7〜9年間墓地に残ります。";	}
			
			{	String _name = "DSSVCemeteryNOF";		String _text = "柵のない村の墓地";	}
			{	String _name = "DSSVCemeteryNOFLwr";		String _text = "柵のない村の墓地";	}
