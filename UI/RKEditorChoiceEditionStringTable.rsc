		{	String _name = "OrchardLodges2ToolbarTip";		String _text = "トロピカル 山小屋のツールバー。このツールバーを開いて、トロピカル オーチャード 山小屋のオプションを取得します。 (木を選択的に伐採し、新しい熱帯果樹の苗木を植えるためのエリアを定義するために使用されます。コスト: 木材 32、石 12。半径: 24 タイル。雇用: 1 ～ 2 人の森林官。)";	}

