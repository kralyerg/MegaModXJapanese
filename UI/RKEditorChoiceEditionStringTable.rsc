		{	String _name = "ClearFlower";		String _text = "花を集める";	}
		{	String _name = "ClearFlowerLwr";		String _text = "花を集める";	}
		{	String _name = "ClearFlowerTip";		String _text = "選択したエリアに出現する花を集めて収穫します。ヒント: 花にはさまざまなフラグがあります。花の各パッチは 3 ～ 5 個の花を作成します (値 1)。さまざまなアイテムを受け入れる納屋があることを確認してください。";	}

		{	String _name = "ClearHerb";		String _text = "薬草を集める";	}
		{	String _name = "ClearHerbLwr";		String _text = "薬草を集める";	}
		{	String _name = "ClearHerbTip";		String _text = "選択したエリアでスポーンする薬草を収集して収穫します。ヒント: 薬草は薬草医 (または浴場) で使用すると、使用ごとにハートの 1/2 が回復します。薬草の各パッチは 2 ～ 3 個の薬草を作成します (値 4)。薬草には納屋タイプの保管場所が必要です。";	}

		{	String _name = "ClearCopper";		String _text = "銅を集める";	}
		{	String _name = "ClearCopperLwr";		String _text = "銅を集める";	}
		{	String _name = "ClearCopperTip";		String _text = "選択したエリアで銅とその他の希少鉱物 (金と銀) をすべて収集します。ヒント: 銅はいくつかの道具の製造に使用されるほか、建築材料としても使用されます。銅やその他の希少な鉱石は鉱物です。材料の備蓄があることを確認してください。 2 ～ 3 個の銅鉱石 (値 4)、1 ～ 2 個の銀鉱石 (値 11)、または 1 ～ 2 個の金鉱石 (値 22) が抽出されます。それらを保管できる鉱物の備蓄があることを確認してください。";	}

		{	String _name = "ClearAlmostAll";		String _text = "ほぼすべてを集める";	}
		{	String _name = "ClearAlmostAllLwr";		String _text = "ほぼ全部集める";	}
		{	String _name = "ClearAlmostAllTip";		String _text = "選択したエリア内のすべての鉱石と石を収集します。ヒント: この特別なツールは、すべての鉱石とすべての石を集めます。木や草、その他貴重な野生のものは取り除きません。森林管理者の周囲のすべての土地を素早​​く掃除するのに非常に役立ちます。";	}

