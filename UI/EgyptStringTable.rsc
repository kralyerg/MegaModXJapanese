	// ------------ New Egypt Starting Conditions ---------------------------
		{	String _name = "EgyptEasyName";		String _text = "エジプト - イージー";	}
		{	String _name = "EgyptEasyDesc";		String _text = "ヤシの木のみが生えるエジプトの標準イージーゲームです。イージーゲームは6家族で始まります。衣類、食料、薪、建築資材、道具が豊富に用意されています。住居と保管施設はすでに建てられています。畑や果樹園用の種、そして家畜の群れも用意されています。";	}

		{	String _name = "EgyptMediumName";		String _text = "エジプト - ミディアム";	}
		{	String _name = "EgyptMediumDesc";		String _text = "ヤシの木のみが生えるエジプトの標準ミディアムゲームです。ミディアムゲームは5家族で始まります。衣類、食料、薪、道具、建築資材が用意されています。保管倉庫はすでに建てられています。畑や果樹園用の種も多少用意されています。";	}

		{	String _name = "EgyptHardName";		String _text = "エジプト - ハード";	}
		{	String _name = "EgyptHardDesc";		String _text = "ヤシの木のみが生えるエジプトの標準ハードゲームです。ハードゲームは4家族で始まります。衣類、食料、薪、道具がわずかに用意されています。農業用の種は手に入りません。";	}

		{	String _name = "EgyptAEName";		String _text = "エジプト - アダムとイヴ";	}
		{	String _name = "EgyptAEDesc";		String _text = "ヤシの木のみが生えるエジプトの標準アダムとイヴゲームです。わずか2人からスタートします。小さな荷車に少量の食料、薪、衣類が用意されています。建物は何も建てられておらず、種や家畜も最初は用意されていません。すべてを自分たちの力で生き延び、手に入れる必要があります。";	}

