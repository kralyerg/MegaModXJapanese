		{	String _name = "DSThompsonTradeMerchantFVGTip";		String _text = "トンプソン貿易商は、果物・野菜・穀物の輸入を専門としています。商人はほとんどの物資を対価として受け取ります。収容量40,000、敷地サイズ8x8。商人1～13人を雇用します。建築には144の労働力が必要です。";	}

		{	String _name = "DSThompsonTradeMerchantProtein";		String _text = "取引：タンパク質";	}
		{	String _name = "DSThompsonTradeMerchantProteinLwr";		String _text = "トンプソンタンパク質取引";	}
		{	String _name = "DSThompsonTradeMerchantProteinTip";		String _text = "トンプソン貿易商は、肉・種子・ナッツなどすべてのタンパク質の輸入を専門としています。商人はほとんどの物資を対価として受け取ります。収容量12,000、敷地サイズ4x6。商人1～3人を雇用します。建築には55の労働力が必要です。";	}

		{	String _name = "DSThompsonTradeMerchantFuels";		String _text = "取引：燃料";	}
		{	String _name = "DSThompsonTradeMerchantFuelsLwr";		String _text = "トンプソン燃料取引";	}
		{	String _name = "DSThompsonTradeMerchantFuelsTip";		String _text = "トンプソン燃料貿易商は、薪、木炭、コークスなど家庭用・冶金用の燃料全般の輸入を専門としています。商人はほとんどの物資を対価として受け取ります。収容量12,000、敷地サイズ4x6。商人1～3人を雇用します。建築には55の労働力が必要です。";	}

		{	String _name = "DSThompsonTradeMerchantGoods";		String _text = "取引：日用品・工芸品";	}
		{	String _name = "DSThompsonTradeMerchantGoodsLwr";		String _text = "トンプソン日用品取引";	}
		{	String _name = "DSThompsonTradeMerchantGoodsTip";		String _text = "トンプソン日用品貿易商は、道具、衣類、織物・布地、香草・薬、工芸品・調度品、ガラス、金属・合金・鍛造品の輸入を専門としています。商人はほとんどの物資を対価として受け取ります。収容量40,000、敷地サイズ8x8。商人1～5人を雇用します。建築には144の労働力が必要です。";	}

		{	String _name = "DSThompsonTradeMerchantMinerals";		String _text = "取引：鉱石・資材";	}
