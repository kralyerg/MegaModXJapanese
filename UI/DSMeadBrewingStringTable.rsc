StringTable resource
{
	Entry _strings
	[
		{	String _name = "DSVillageSquareMeadBrewer";		String _text = "広場の蜂蜜酒屋";	}
		{	String _name = "DSVillageSquareMeadBrewerLwr";		String _text = "広場の蜂蜜酒屋";	}
		{	String _name = "DSVillageSquareMeadBrewerTip";		String _text = "広場の蜂蜜酒屋は、ミードとホットミードを醸造して提供する小さな建物です。ミードは「蜂蜜＋水」または「野生蜂蜜＋水」から造られます。ホットミードは「ミード＋香草」から造られます。醸造士1人を雇用します。合計で重量250まで保管できます。建築には55の労働力が必要です。";	}
		{	String _name = "DSVillageMeadery";		String _text = "村の蜂蜜酒蔵";	}
		{	String _name = "DSVillageMeaderyLwr";		String _text = "村の蜂蜜酒蔵";	}
		{	String _name = "DSVillageMeaderyTip";		String _text = "村の蜂蜜酒蔵は、住民にミードとホットミードを醸造して提供する酒場です。ミードは「蜂蜜＋水」または「野生蜂蜜＋水」から造られます。ホットミードは「ミード＋香草」から造られます。醸造士1～4人を雇用します。酒蔵は合計で重量600まで保管できます。建築には144の労働力が必要です。";	}
		{	String _name = "MeadWaterRequire";		String _text = "7-10 ミード [ハチミツ 40 + 水 20]";	}
		{	String _name = "MeadWildHoneyWaterRequire";		String _text = "7-10 ミード [ワイルドハニー 40 + 水 20]";	}
		{	String _name = "MulledMeadRequire";		String _text = "3-5 ホットミード [ミード1個+薬草1個]";	}
		{	String _name = "DSVillageStorageShed2x2";		String _text = "村の貯蔵小屋（2x2）";	}
		{	String _name = "DSVillageStorageShed2x2Lwr";		String _text = "村の貯蔵小屋";	}
		{	String _name = "DSVillageStorageShed2x2Tip";		String _text = "2x2の村の貯蔵小屋は、すべての食料、香草・薬、道具、衣類、工芸品・調度品を保管できる簡素な掛け小屋です。総保管容量は重量900。建築には21の労働力が必要です。";	}
		{	String _name = "DSVillageStorageShed2x3";		String _text = "村の貯蔵小屋（2x3）";	}
		{	String _name = "DSVillageStorageShed2x3Lwr";		String _text = "村の貯蔵小屋";	}
		{	String _name = "DSVillageStorageShed2x3Tip";		String _text = "2x3の村の貯蔵小屋は、すべての食料、香草・薬、道具、衣類、工芸品・調度品を保管できる簡素な掛け小屋です。総保管容量は重量1250。建築には29の労働力が必要です。";	}
		{	String _name = "DSVillageBeehiveTrunks";		String _text = "村の蜂の巣";	}
		{	String _name = "DSVillageBeehiveTrunksLwr";		String _text = "村の蜂の巣";	}
		{	String _name = "DSVillageBeehiveTrunksTip";		String _text = "村の蜂の巣では、養蜂家が蜂を世話し、蜂蜜、蜜蝋、巣蜜をランダムに収穫します。養蜂家1人を雇用します。建築には34の労働力が必要です。";	}
		{	String _name = "DSVillageApiary";		String _text = "村の養蜂場";	}
		{	String _name = "DSVillageApiaryLwr";		String _text = "村の養蜂場";	}
		{	String _name = "DSVillageApiaryTip";		String _text = "村の養蜂場では、養蜂家が蜂を世話し、蜂蜜、蜜蝋、巣蜜、ローヤルゼリーをランダムに収穫します。養蜂家1～2人を雇用します。建築には89の労働力が必要です。";	}
		{	String _name = "DSVillageApiaryProduce";		String _text = "村の養蜂場";	}
		{	String _name = "DSVillageApiaryProduceLwr";		String _text = "村の養蜂場";	}
		{	String _name = "DSVillageApiaryProduceTip";		String _text = "村の養蜂場では、養蜂家が蜂を世話し、蜂蜜、巣蜜、蜜蝋のいずれかを収穫します。養蜂家1～2人を雇用します。建築には89の労働力が必要です。";	}
		{	String _name = "HoneyRequire";		String _text = "ハニー";	}
		{	String _name = "CombHoneyRequire";		String _text = "巣蜜";	}
		{	String _name = "BeeswaxRequire";		String _text = "蜜蝋";	}
		{	String _name = "DSVillageWaterWell";		String _text = "村の水井戸";	}
		{	String _name = "DSVillageWaterWellLwr";		String _text = "村の水井戸";	}
		{	String _name = "DSVillageWaterWellTip";		String _text = "村の水井戸では、作業員が井戸を管理し、住民が飲用または材料として使う水を集めます。作業員1人を雇用します。建築には55の労働力が必要です。";	}
		{	String _name = "DSVillageMeaderyTables";		String _text = "村の酒蔵テーブル";	}
		{	String _name = "DSVillageMeaderyTablesLwr";		String _text = "村の酒蔵テーブル";	}
		{	String _name = "DSVillageMeaderyTablesTip";		String _text = "半透明表示の装飾用アイテム、村の酒蔵テーブル。Fキーでバリエーション切替。建築費は無料です。削除はオブジェクトUIメニューから行ってください。";	}
	]

}

