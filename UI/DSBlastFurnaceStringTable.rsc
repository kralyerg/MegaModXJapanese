		{	String _name = "DSCoalBellPit1Tip";		String _text = "平らな地面に建設された原始的な石炭鉱山には、地面にある「鐘」型の穴からのみ石炭を抽出する 3 ～ 8 人の鉱山労働者が必要です。限定生産（600個）のため、その後廃番となります。鉱山の建設には 34 の作業が必要です。";	}
			{	String _name = "DSCoalBellPit1Upgrade";		String _text = "コールベルピット鉱山";	}
			{	String _name = "DSCoalBellPit1UpgradeLwr";		String _text = "コールベルピット鉱山";	}
			{	String _name = "DSCoalBellPit1UpgradeTip";		String _text = "アップグレードすると、寿命が長くなり (5,400)、採掘者を支援する滑車システムの追加により石炭の抽出がわずかに速くなります (最大 13 名の採掘者)。鉱山をアップグレードするには 89 の作業が必要です。";	}
		
	
		{	String _name = "DSSmallIronOreMine";		String _text = "小さな鉄鉱石鉱山";	}
