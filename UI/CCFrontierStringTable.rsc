	// #########################################
	// ##          Starting Settings          ##
	// #########################################

		{	String _name = "CCAdamEve";		String _text = "[CC] アダムとイブ";	}
		{	String _name = "CCAdamEveDesc";		String _text = "たった2人からスタート。少量の食料、薪、衣類は小さな収納台車に入れて提供されます。建物はまだ建設されておらず、種や家畜も最初は利用できません。生き残ってすべてを手に入れる必要があります。";	}
		
		{	String _name = "CCMissionary";		String _text = "[CC] 宣教師";	}
		{	String _name = "CCMissionaryDesc";		String _text = "宣教師のゲームは教区の家と 3 つの家族から始まりますが、そのうち 2 人は教育を受けていません。すでに2軒の家が建てられており、いくつかの基本的な物資が提供されています。収納台車をご利用いただけます。畑や果樹園用の種や家畜の群れも入手できます。";	}
		
		{	String _name = "CCFort";		String _text = "[CC] ニューフロンティア";	}
		{	String _name = "CCFortDesc";		String _text = "ニュー フロンティアは、フレンドリーなネイティブ アメリカンの村に隣接する辺境の前哨基地から始まります。国民を守り育てれば、あなたの伝説は西側に永遠に語り継がれるでしょう。このゲームは 3 つの家族から始まり、いくつかの物資を備えた小さな砦がすでに建設されています。儀式場で宝物を発見するオプションが含まれます。";	}

		{	String _name = "CCFortHard";		String _text = "[CC] ネイティブ ヴィレッジ - ハード";	}
		{	String _name = "CCFortHardDesc";		String _text = "ネイティブ ビレッジのスタートでは、その地域の先住民部族と良好な関係を築く必要があり、かなり難しいスタートです。村では友情を示すための資源 (アップグレード) が必要になります。その後、建物とどのように対話するかを選択できます。この土地の外国人として、敵ではなく同盟を求めることから学び、得るものはたくさんあります。";	}

		{	String _name = "CCFortAE";		String _text = "[CC] ネイティブ ビレッジ - アダムとイブ";	}
		{	String _name = "CCFortAEDesc";		String _text = "たった2人からスタート。少量の食料、薪、衣類は小さな収納台車に入れて提供されます。ネイティブ ビレッジのスタートでは、その地域の先住民部族と良好な関係を築く必要があり、かなり難しいスタートです。村では友情を示すための資源 (アップグレード) が必要になります。その後、建物とどのように対話するかを選択できます。この土地の外国人として、敵ではなく同盟を求めることから学び、得るものはたくさんあります。";	}

		{	String _name = "LlamaEasyName";		String _text = "[CC] ゴールデンラマの呪い - 簡単";	}
		{	String _name = "LlamaEasyDesc";		String _text = "ゴールデンラマの呪いは、Banished の世界で最も謎に近いものです。ゴールデンラマとは何ですか？そこにはどんな謎が隠されているのでしょうか？その薄暗い内部を探索してみませんか?これは通常の Easy 設定に従って開始されるゲームですが、宝物を獲得するチャンスを求めて冒険するオプションが含まれています。";	}

		{	String _name = "LlamaMediumName";		String _text = "[CC] ゴールデンラマの呪い - 中";	}
		{	String _name = "LlamaMediumDesc";		String _text = "ゴールデンラマの呪いは、Banished の世界で最も謎に近いものです。ゴールデンラマとは何ですか？そこにはどんな謎が隠されているのでしょうか？その薄暗い内部を探索してみませんか?これは通常の Medium 設定に従って開始されるゲームですが、宝物を得るチャンスを求めて冒険するオプションが含まれています。";	}

		{	String _name = "LlamaHardName";		String _text = "[CC] ゴールデンラマの呪い - ハード";	}
		{	String _name = "LlamaHardDesc";		String _text = "ゴールデンラマの呪いは、Banished の世界で最も謎に近いものです。ゴールデンラマとは何ですか？そこにはどんな謎が隠されているのでしょうか？その薄暗い内部を探索してみませんか?これは通常のハード設定に従って開始されるゲームですが、宝物を獲得するチャンスを求めて冒険するオプションが含まれています。";	}

		{	String _name = "LlamaAEName";		String _text = "[CC] ゴールデンラマの呪い - アダムとイブ";	}
		{	String _name = "LlamaAEDesc";		String _text = "ゴールデンラマの呪いは、Banished の世界で最も謎に近いものです。ゴールデンラマとは何ですか？そこにはどんな謎が隠されているのでしょうか？その薄暗い内部を探索してみませんか?これはアダムとイブの設定に従って開始されるゲームですが、宝物を得るチャンスを求めて冒険するオプションが含まれています。";	}


