		{	String _name = "DSWagonVendorLwr";		String _text = "一般的なワゴン販売業者";	}
		{	String _name = "DSWagonVendorTip";		String _text = "小型ワゴン市場、3000cap。 (食べ物、道具、健康、衣類、工芸品)。 1 ～ 3 社の露店商を雇用しています。半径34。ワゴンを「開梱」するには、ワゴンパーツ 2 つ + 9 つの作業が必要です。ワゴンパーツはワゴン工房で作成できます。ワゴンは道路に建設可能で、建物 UI のボタンによってのみ削除できます。";	}
		
