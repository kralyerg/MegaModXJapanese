		{	String _name = "NMT30LightHouseLwr";		String _text = "灯台";	}
		{	String _name = "NMT30LightHouseTip";		String _text = "灯台は町の統計を提供し、遠くから遊牧民を呼び寄せます。サイズ: 11x8。コスト: 木材 58、石 98、鉄 14、銅 16、ガラス 24、薪 32。雇用: 消防士 1 名。ヒント: 遊牧民を呼び寄せられるよう、花火師が頂上で火の始末をしてくれます。ライト住宅は、市庁舎が提供できるすべてのサービスを提供します。";	}

		{	String _name = "NMT30Watertower";		String _text = "給水塔";	}
		{	String _name = "NMT30WatertowerLwr";		String _text = "給水塔";	}
		{	String _name = "NMT30WatertowerTip";		String _text = "給水塔は住民に新鮮な水を提供します。サイズ: 4x5。コスト: 丸太 34 本、鉄 8 本。給水塔から水を12～15個作ることができます。 雇用形態：従業員1～2名。ヒント: 水は食べ物として機能しますが、栄養素はありません。一部の建物（温室など）では、時間の経過とともに投入物として水を必要とします。";	}

