StringTable resource
{
	Entry _strings
	[ 

		{	String _name = "PalmsOnlyEasyName";		String _text = "[CC] アンティル諸島 - 簡単";	}
		{	String _name = "PalmsOnlyEasyDesc";		String _text = "ヤシの木と熱帯の木だけを使った標準的な簡単なゲーム。 6人の家族で簡単なゲームが始まります。大量の衣類、食料、薪、建築資材、道具が提供されます。家や倉庫はすでに建てられています。畑や果樹園用の種のほか、家畜の群れも入手できます。";	}

		{	String _name = "PalmsOnlyMediumName";		String _text = "[CC] アンティル諸島 - 中";	}
		{	String _name = "PalmsOnlyMediumDesc";		String _text = "ヤシの木と熱帯の木のみを使用した標準の中規模ゲーム。中試合は 5 つの家族で始まります。衣類、食料、薪、工具、建設資材が提供されます。すでに倉庫が建てられています。畑や果樹園用の種もいくつかあります。";	}

		{	String _name = "PalmsOnlyHardName";		String _text = "[CC] アンティル諸島 - ハード";	}
		{	String _name = "PalmsOnlyHardDesc";		String _text = "ヤシの木と熱帯の木だけを使った標準的なハード ゲーム。家族4人による過酷なゲームが始まる。少量の衣類、食料、薪、道具が提供されます。農業用の種は入手できません。";	}

		{	String _name = "PalmsOnlyAEName";		String _text = "[CC] アンティル諸島 - アダムとイブ";	}
		{	String _name = "PalmsOnlyAEDesc";		String _text = "ヤシの木と熱帯の木だけを使った標準的なアダムとイブのゲーム。たった2人からスタート。少量の食料、薪、衣類は小さな収納台車に入れて提供されます。建物はまだ建設されておらず、種や家畜も最初は利用できません。生き残ってすべてを手に入れる必要があります。";	}

	]
}

